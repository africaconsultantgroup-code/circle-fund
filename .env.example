# Supabase client configuration for SikaCircle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=pk.eyJ...your-public-anon-key...

# Optional server-side keys for secure backend operations (do not commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Official Ghana Card / identity provider credentials for Supabase Edge Functions only.
# Never expose these with a VITE_ prefix.
NIA_API_BASE_URL=https://provider.example.gov.gh
NIA_API_KEY=your-provider-api-key
NIA_CLIENT_ID=your-provider-client-id
NIA_CLIENT_SECRET=your-provider-client-secret
