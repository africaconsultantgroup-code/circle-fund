# Supabase client configuration for SikaCircle
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=pk.eyJ...your-public-anon-key...
VITE_APP_URL=https://app.sikacircle.com
VITE_ENABLE_DIASPORA_TEST_OTP=true

# Auth configuration note:
# When Hubtel phone OTP is the primary verification method, disable Supabase email
# confirmation in the Supabase Auth settings so signup creates an immediate session.

# Optional server-side keys for secure backend operations (do not commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Hubtel OTP / SMS credentials for Supabase Edge Functions only.
# Configure these as Supabase secrets, never with a VITE_ prefix.
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_SENDER_ID=your-approved-hubtel-sender-id
# Keep false unless your Hubtel account is approved for international SMS.
HUBTEL_ENABLE_INTERNATIONAL_SMS=false
# Placeholder for future diaspora SMS providers: twilio, messagebird, termii, etc.
# Until implemented, non-Ghana numbers use visible Diaspora Test OTP mode.
INTERNATIONAL_SMS_PROVIDER=

# Hubtel payment collection credentials for Supabase Edge Functions only.
# These are separate from OTP credentials. Do not reuse HUBTEL_CLIENT_ID or HUBTEL_CLIENT_SECRET here.
HUBTEL_PAYMENT_CLIENT_ID=your-hubtel-payment-client-id
HUBTEL_PAYMENT_CLIENT_SECRET=your-hubtel-payment-client-secret
HUBTEL_PAYMENT_MERCHANT_ACCOUNT=your-hubtel-payment-merchant-account
HUBTEL_CALLBACK_URL=https://your-project-ref.functions.supabase.co/hubtel-payment-webhook
HUBTEL_RETURN_URL=https://app.sikacircle.com/payments
HUBTEL_PAYMENT_ENV=sandbox
# Optional override if Hubtel gives you a different checkout initiation URL.
HUBTEL_PAYMENT_INITIATE_URL=https://payproxyapi.hubtel.com/items/initiate

# Official Ghana Card / identity provider credentials for Supabase Edge Functions only.
# Never expose these with a VITE_ prefix.
NIA_API_BASE_URL=https://provider.example.gov.gh
NIA_API_KEY=your-provider-api-key
NIA_CLIENT_ID=your-provider-client-id
NIA_CLIENT_SECRET=your-provider-client-secret

# Developer/admin-only test override for Supabase Edge Function admin-mark-test-user-verified.
# Do not expose this in frontend code.
ADMIN_VERIFICATION_TEST_SECRET=replace-with-long-random-secret
